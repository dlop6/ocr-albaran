# Configuración de rate limiting (opcional)
# Ventana de tiempo en ms (default: 900000 = 15 min)
# RATE_LIMIT_WINDOW_MS=900000
# Máximo de requests por IP por ventana (default: 100)
# RATE_LIMIT_MAX=100
# Orígenes permitidos para CORS (separados por coma, sin espacios)
# Ejemplo: CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Ejemplo de configuración de entorno para OCR Albarán

# Puerto del servidor Express
PORT=3000


# Concurrencia máxima de OCR (páginas en paralelo)
OCR_CONCURRENCY=5

# Timeout global de petición HTTP en milisegundos (default: 600000 = 10 minutos)
# HTTP_TIMEOUT_MS=600000
 
# Bizagi callback configuration
# Base URL (no trailing slash), for example: https://my-bizagi.example.com
BIZAGI_BASE_URL=
# Bearer token used to authenticate callbacks to Bizagi
BIZAGI_TOKEN=
